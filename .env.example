# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Every variable without a default is REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (required) ---
# Postgres connection string. The app fails fast at boot if this is missing.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth.js (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Canonical public origin. Required in production; no hardcoded fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Platform AI key (required) ---
# Used for the free trial and for paid subscribers.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override.
GEMINI_MODEL_ID=gemini-2.5-flash

# --- BYOK tier (required to enable bring-your-own-key) ---
# 32 random bytes, base64. Encrypts user-supplied API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# If unset, the BYOK tier is disabled and the UI hides it.
BYOK_ENCRYPTION_KEY=
# Fair-use throttle for BYOK users (protects our compute, not our AI spend).
BYOK_RATE_LIMIT_PER_MINUTE=10

# --- Telegram bot (required for the Telegram surface) ---
TELEGRAM_BOT_TOKEN=
# Random secret. Must match the value passed to setWebhook.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Billing (required for the paid tier) ---
# Pick ONE provider and delete the other block.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=

# --- Realtime (optional) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Entitlement tuning (optional, defaults shown) ---
FREE_TRIAL_DAYS=7
FREE_TRIAL_AI_LOG_LIMIT=50
PAID_DAILY_AI_LOG_LIMIT=25

# --- Localisation (optional, defaults shown) ---
DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DATE_LOCALE=en-IN
